PROJECT_NAME="FHK Backend API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Seguridad JWT (Cambiar en producción con: openssl rand -hex 32)
SECRET_KEY="fhk-dev-secret-key-change-in-production-9f8e7d6c5b4a3f2e1d0c"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Base de datos:
# En desarrollo (SQLite local):
DATABASE_URL="sqlite:///./fhk.db"
# En producción (PostgreSQL):
# DATABASE_URL="postgresql://usuario:password@localhost:5432/fhk_db"

# Orígenes permitidos por CORS (separados por coma)
BACKEND_CORS_ORIGINS="*"
