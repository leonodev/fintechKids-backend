  "components": {
    "schemas": {
      "AppVersionCheckResponse": {
        "properties": {
          "platform": {
            "$ref": "#/components/schemas/PlatformEnum",
            "description": "Plataforma consultada (`IOS` para Apple App Store, `AND` para Google Play Store)",
            "examples": [
              "IOS"
            ]
          },
          "current_version": {
            "type": "string",
            "title": "Current Version",
            "description": "Versión instalada actualmente en el dispositivo del usuario",
            "examples": [
              "1.0.0"
            ]
          },
          "latest_version": {
            "type": "string",
            "title": "Latest Version",
            "description": "Última versión disponible en la tienda correspondiente",
            "examples": [
              "1.2.0"
            ]
          },
          "min_required_version": {
            "type": "string",
            "title": "Min Required Version",
            "description": "Versión mínima permitida para seguir usando la app sin actualizar",
            "examples": [
              "1.0.0"
            ]
          },
          "is_up_to_date": {
            "type": "boolean",
            "title": "Is Up To Date",
            "description": "`true` si la app ya tiene instalada la última versión (o superior) de la tienda",
            "examples": [
              false
            ]
          },
          "update_available": {
            "type": "boolean",
            "title": "Update Available",
            "description": "`true` si existe una versión más reciente publicada en la tienda",
            "examples": [
              true
            ]
          },
          "force_update": {
            "type": "boolean",
            "title": "Force Update",
            "description": "`true` si la actualización es obligatoria (bloqueante) para continuar usando la app",
            "examples": [
              false
            ]
          },
          "store_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Store Url",
            "description": "Enlace directo a la tienda (App Store / Google Play) para descargar la actualización",
            "examples": [
              "https://apps.apple.com/app/id000000000"
            ]
          },
          "release_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Release Notes",
            "description": "Notas de la versión con las novedades disponibles en tienda",
            "examples": [
              "Mejoras de rendimiento y nuevas funcionalidades de seguridad."
            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Mensaje descriptivo listo para mostrar al usuario o registrar en logs",
            "examples": [
              "Hay una nueva versión (1.2.0) disponible en la tienda."
            ]
          }
        },
        "type": "object",
        "required": [
          "platform",
          "current_version",
          "latest_version",
          "min_required_version",
          "is_up_to_date",
          "update_available",
          "force_update",
          "message"
        ],
        "title": "AppVersionCheckResponse"
      },
      "AppVersionConfigResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "platform": {
            "$ref": "#/components/schemas/PlatformEnum"
          },
          "latest_version": {
            "type": "string",
            "title": "Latest Version"
          },
          "min_required_version": {
            "type": "string",
            "title": "Min Required Version"
          },
          "force_update": {
            "type": "boolean",
            "title": "Force Update"
          },
          "store_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Store Url"
          },
          "release_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Release Notes"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "platform",
          "latest_version",
          "min_required_version",
          "force_update",
          "updated_at"
        ],
        "title": "AppVersionConfigResponse"
      },
      "AppVersionConfigUpdate": {
        "properties": {
          "latest_version": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "title": "Latest Version",
            "description": "Última versión publicada en la tienda (formato semántico ej. 1.2.0)",
            "examples": [
              "1.3.0"
            ]
          },
          "min_required_version": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "title": "Min Required Version",
            "description": "Versión mínima obligatoria (clientes con versión menor verán force_update=true)",
            "examples": [
              "1.1.0"
            ]
          },
          "force_update": {
            "type": "boolean",
            "title": "Force Update",
            "description": "Si es `true`, fuerza la actualización a todos los usuarios que no estén en `latest_version`",
            "default": false
          },
          "store_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Store Url",
            "description": "URL oficial de la app en App Store o Google Play",
            "examples": [
              "https://apps.apple.com/app/id000000000"
            ]
          },
          "release_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Release Notes",
            "description": "Notas de lanzamiento de la versión actual",
            "examples": [
              "Corrección de errores y mejoras de estabilidad."
            ]
          }
        },
        "type": "object",
        "required": [
          "latest_version",
          "min_required_version"
        ],
        "title": "AppVersionConfigUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ItemCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "description": "Título del elemento",
            "examples": [
              "Suscripción Premium"
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "Descripción detallada del elemento",
            "examples": [
              "Acceso completo a todos los servicios desde la app móvil"
            ]
          },
          "price": {
            "type": "number",
            "minimum": 0.0,
