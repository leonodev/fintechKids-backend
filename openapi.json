{
  "openapi": "3.1.0",
  "info": {
    "title": "FHK Backend API",
    "description": "Backend REST API con autenticación JWT, seguridad, persistencia en base de datos y documentación interactiva OpenAPI/Swagger auto-generada.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "0. Estado del Servidor"
        ],
        "summary": "Health Check del Backend",
        "description": "Verifica que el servidor esté activo y listo para recibir peticiones.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "1. Autenticación"
        ],
        "summary": "Registrar nueva familia / padre",
        "description": "Registra una familia en la base de datos recibiendo `name_family`, `email_parent` y `approve_pin`. El campo `created_at` se asigna automáticamente en el servidor con la hora actual en UTC.",
        "operationId": "register_user_api_v1_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "1. Autenticación"
        ],
        "summary": "Iniciar sesión desde la App (JSON)",
        "description": "Recibe `email_parent` y `approve_pin` en formato JSON y devuelve un `access_token` y `refresh_token` JWT.",
        "operationId": "login_json_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "1. Autenticación"
        ],
        "summary": "Renovar Access Token usando Refresh Token",
        "description": "Permite a la app móvil obtener un nuevo `access_token` sin obligar al usuario a iniciar sesión nuevamente.",
        "operationId": "refresh_access_token_api_v1_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "tags": [
          "2. Usuarios"
        ],
        "summary": "Obtener datos de la familia / padre autenticado",
        "description": "Devuelve la información registrada de la familia propietaria del token JWT actual.",
        "operationId": "read_current_user_api_v1_users_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2Password": []
          },
          {
            "BearerJWT": []
          }
        ]
      },
      "patch": {
        "tags": [
          "2. Usuarios"
        ],
        "summary": "Actualizar nombre de familia o PIN del padre autenticado",
        "description": "Permite actualizar `name_family` o `approve_pin` de la cuenta autenticada.",
        "operationId": "update_current_user_api_v1_users_me_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2Password": []
          },
          {
            "BearerJWT": []
          }
        ]
      }
    },
    "/api/v1/app-version/check": {
      "get": {
        "tags": [
          "3. Versión de la App (Tiendas)"
        ],
        "summary": "Verificar si la App tiene la última versión de tiendas",
        "description": "Servicio **GET** público que recibe la `current_version` instalada en el dispositivo y la `platform` (`IOS` o `AND`), comparándola contra la última versión publicada en tiendas para indicar si está actualizada, si hay actualización disponible o si requiere actualización forzosa.",
        "operationId": "check_app_version_api_v1_app_version_check_get",
        "parameters": [
          {
            "name": "platform",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PlatformEnum",
              "description": "Plataforma del dispositivo: `IOS` (Apple App Store) o `AND` (Google Play Store)",
              "examples": [
                "IOS"
              ]
            },
            "description": "Plataforma del dispositivo: `IOS` (Apple App Store) o `AND` (Google Play Store)"
          },
          {
            "name": "current_version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30,
              "description": "Versión actual instalada en la app (ej. `1.0.0` o `1.2.0`)",
              "examples": [
                "1.0.0"
              ],
              "title": "Current Version"
            },
            "description": "Versión actual instalada en la app (ej. `1.0.0` o `1.2.0`)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppVersionCheckResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/app-version": {
      "get": {
        "tags": [
          "3. Versión de la App (Tiendas)"
        ],
        "summary": "Listar versiones actuales configuradas en tiendas (IOS y AND)",
        "description": "Devuelve la configuración actual almacenada en base de datos para ambas plataformas.",
        "operationId": "list_store_versions_api_v1_app_version_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AppVersionConfigResponse"
                  },
                  "type": "array",
                  "title": "Response List Store Versions Api V1 App Version Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/app-version/{platform}": {
      "put": {
        "tags": [
          "3. Versión de la App (Tiendas)"
        ],
        "summary": "Actualizar la versión publicada en tienda para IOS o AND (Protegido con JWT)",
        "description": "Permite actualizar en la base de datos cuál es la última versión en tiendas (`latest_version`), la versión mínima requerida (`min_required_version`) y si la actualización es obligatoria (`force_update`).",
        "operationId": "update_store_version_api_v1_app_version__platform__put",
        "security": [
          {
            "OAuth2Password": []
          },
          {
            "BearerJWT": []
          }
        ],
        "parameters": [
          {
            "name": "platform",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PlatformEnum"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppVersionConfigUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppVersionConfigResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/items": {
      "get": {
        "tags": [
          "4. Elementos (CRUD Ejemplo)"
        ],
        "summary": "Listar elementos del usuario",
        "description": "Obtiene la lista paginada de elementos pertenecientes al usuario autenticado.",
        "operationId": "list_items_api_v1_items_get",
        "security": [
          {
            "OAuth2Password": []
          },
          {
            "BearerJWT": []
          }
        ],
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Número de registros a omitir",
              "default": 0,
              "title": "Skip"
            },
            "description": "Número de registros a omitir"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Máximo de registros a devolver",
              "default": 50,
              "title": "Limit"
            },
            "description": "Máximo de registros a devolver"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ItemResponse"
                  },
                  "title": "Response List Items Api V1 Items Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "4. Elementos (CRUD Ejemplo)"
        ],
        "summary": "Crear un nuevo elemento",
        "description": "Persiste un nuevo elemento en la base de datos asociado al usuario autenticado.",
        "operationId": "create_item_api_v1_items_post",
